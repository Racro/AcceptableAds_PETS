# AcceptableAds Docker Environment Configuration

# Crawler Configuration
CRAWLER_TYPE=control
NODE_ENV=production

# Processing Service Configuration
PYTHONPATH=/app
TESSERACT_CMD=/usr/bin/tesseract

# Crawler Timeout and Retry Settings
CRAWLER_TIMEOUT=90
CRAWLER_MAX_RETRIES=3

# OCR Configuration
OCR_FALLBACK=true

# Debug Mode
DEBUG=false

# OpenAI API Key (for LLM annotation)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom URLs file path
URLS_FILE=accads_crawler/websites_1500.txt

# Optional: Number of URLs to crawl
NUM_URLS=5

# Optional: Timeout per URL in seconds
URL_TIMEOUT=300 